FETCHHARBOR_ENV=production
FETCHHARBOR_HOST=0.0.0.0
FETCHHARBOR_PORT=8080
FETCHHARBOR_PUBLIC_URL=https://fetchharbor.example.com
FETCHHARBOR_PAYMENT_MODE=disabled
FETCHHARBOR_X402_NETWORK=eip155:84532
FETCHHARBOR_X402_PAY_TO=0x0000000000000000000000000000000000000000
FETCHHARBOR_X402_ASSET=0x036CbD53842c5426634e7929541eC2318f3dCF7e
FETCHHARBOR_X402_ASSET_NAME=USDC
FETCHHARBOR_X402_ASSET_VERSION=2
FETCHHARBOR_X402_ASSET_DECIMALS=6
FETCHHARBOR_X402_MAX_TIMEOUT_SECONDS=300
FETCHHARBOR_X402_FACILITATOR=https://x402.org/facilitator
FETCHHARBOR_X402_FACILITATOR_AUTH=none
FETCHHARBOR_X402_CDP_API_KEY_ID=
FETCHHARBOR_X402_CDP_API_KEY_ID_FILE=
FETCHHARBOR_X402_CDP_API_KEY_SECRET=
FETCHHARBOR_X402_CDP_API_KEY_SECRET_FILE=
FETCHHARBOR_PRICE_SCRAPE_USDC=0.01
FETCHHARBOR_PRICE_HTML_TO_MD_USDC=0.005
FETCHHARBOR_PRICE_PDF_PARSE_USDC=0.01
FETCHHARBOR_PRICE_CHAT_USDC=0.01
FETCHHARBOR_MAX_DOWNLOAD_BYTES=20971520
FETCHHARBOR_REQUEST_TIMEOUT_SECONDS=30
FETCHHARBOR_OLLAMA_ENABLED=false
FETCHHARBOR_OLLAMA_BASE_URL=http://ollama:11434
FETCHHARBOR_OLLAMA_MODEL=llama3.2:3b
FETCHHARBOR_OLLAMA_MAX_PROMPT_CHARACTERS=8000
FETCHHARBOR_OLLAMA_MAX_OUTPUT_TOKENS=512
FETCHHARBOR_OLLAMA_MAX_CONCURRENCY=2
FETCHHARBOR_OLLAMA_QUEUE_TIMEOUT_SECONDS=1
FETCHHARBOR_OLLAMA_TIMEOUT_SECONDS=120
FETCHHARBOR_OLLAMA_KEEP_ALIVE=5m
FETCHHARBOR_ADMIN_ENABLED=false
FETCHHARBOR_ADMIN_SESSION_TTL_SECONDS=900
FETCHHARBOR_ADMIN_HOST=admin.fetchharbor.example.com
FETCHHARBOR_ADMIN_TOKEN=replace-with-a-long-random-token
FETCHHARBOR_ADMIN_TOKEN_FILE=
FETCHHARBOR_ADMIN_CONFIG_PATH=/app/data/admin-config.json
FETCHHARBOR_AUDIT_LOG_PATH=/app/data/admin-audit.jsonl
FETCHHARBOR_SECURITY_HEADERS_ENABLED=true
FETCHHARBOR_ALLOWED_HOSTS=localhost,127.0.0.1
FETCHHARBOR_OUTBOUND_PROXY_URL=
FETCHHARBOR_REQUIRE_OUTBOUND_PROXY=false
FETCHHARBOR_PUBLIC_HOST=fetchharbor.example.com
FETCHHARBOR_ADMIN_TOKEN_SECRET_FILE=./secrets/admin_token.txt
