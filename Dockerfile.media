FROM python:3.12-slim@sha256:2c941e860699f878900b0edc2403613c234d4b32eda3cc9fa7036991a2a63c4a
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PYTHONPATH=/app/src
WORKDIR /app
RUN apt-get update \
    && apt-get upgrade --yes --no-install-recommends \
    && apt-get install --yes --no-install-recommends espeak-ng ffmpeg libsndfile1 \
    && rm -rf /var/lib/apt/lists/*
RUN groupadd --system fetchharbor \
    && useradd --system --gid fetchharbor --home /app fetchharbor \
    && install -d -o fetchharbor -g fetchharbor /models
COPY requirements-media.lock ./
RUN python -m pip install --no-cache-dir --require-hashes -r requirements-media.lock \
    && pip uninstall --yes pip setuptools
COPY src ./src
USER fetchharbor
EXPOSE 8090
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=5 CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8090/health', timeout=3)"
CMD ["uvicorn", "fetchharbor.media_worker:app", "--host", "0.0.0.0", "--port", "8090", "--no-access-log"]
