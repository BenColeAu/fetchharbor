# Copy these values into .env only after testnet settlement succeeds.
FETCHHARBOR_PAYMENT_MODE=x402
FETCHHARBOR_X402_NETWORK=eip155:8453
FETCHHARBOR_X402_ASSET=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
FETCHHARBOR_X402_ASSET_NAME=USD Coin
FETCHHARBOR_X402_ASSET_VERSION=2
FETCHHARBOR_X402_ASSET_DECIMALS=6
FETCHHARBOR_X402_PAY_TO=replace-with-operator-receiving-wallet
FETCHHARBOR_X402_FACILITATOR=https://api.cdp.coinbase.com/platform/v2/x402
FETCHHARBOR_X402_FACILITATOR_AUTH=cdp
FETCHHARBOR_X402_CDP_API_KEY_ID_FILE=/run/secrets/cdp_api_key_id
FETCHHARBOR_X402_CDP_API_KEY_SECRET_FILE=/run/secrets/cdp_api_key_secret
